// DriveIQ Cloud — Cloudflare Worker API
// Deploy: npx wrangler deploy
// Dev:    npx wrangler dev
//
// Phase 1: vehicle/maintenance/reminders CRUD, backed by D1.
// Phase 2 (Aiana / RAG): Qdrant + Workers AI embeddings (bge-base-en-v1.5,
// via the native AI binding below — no separate API key) + Anthropic
// generation.
// SECRETS (set out-of-band via `npx wrangler secret put <NAME>`, never
// committed): ANTHROPIC_API_KEY, QDRANT_URL, QDRANT_API_KEY.
// R2 (Phase 3, CARFAX import/uploads) not configured yet.
{
	"name": "driveiq-api",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-07-01",
	"account_id": "5dc9134dee1e699eac6044d2c919e3ec",
	"routes": [
		{
			"pattern": "driveiq-api.ry-ops.dev/*",
			"zone_name": "ry-ops.dev"
		}
	],
	"vars": {
		"QDRANT_COLLECTION": "driveiq_manual_v1",
		"EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
		"CLAUDE_MODEL": "claude-sonnet-4-6"
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "driveiq",
			"database_id": "429ec88a-db5e-429e-9d58-78c571147e8b",
			"migrations_dir": "migrations"
		}
	]
}
